# Mailer Environment Configuration

# Application URL and listening address
BIND_ADDR=0.0.0.0:3000
APP_URL=http://localhost:3000
RUST_LOG=info,mailer=info

# Database connection (PostgreSQL)
DATABASE_URL=postgres://mailer:mailerpass@localhost:5432/mailer

# Application encryption & session signing secret (at least 32 characters)
SECRET_KEY=change-me-in-production-mailer-secret-key-32chars!

# Initial Admin User (auto-seeded on startup if not present)
MAILER_ADMIN_EMAIL=admin@mailer.local
MAILER_ADMIN_PASSWORD=ChangeMe!2026

# Local Mailpit (SMTP: localhost:1025, Web UI: http://localhost:8025)
# Brands will default to sending via Mailpit for local testing.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
